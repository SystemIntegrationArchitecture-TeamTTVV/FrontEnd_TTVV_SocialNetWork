# ─── TTVV Frontend — Environment Variables ──────────────────────────────
# Backend đang host trên VPS: 188.166.225.163

# API Gateway (tất cả REST API đi qua đây)
VITE_API_BASE_URL=http://188.166.225.163:8088

# SocialService / CommonService (WebSocket STOMP + direct calls)
# ⚠️ Cần phải expose port 8081 ra ngoài trong docker-compose.yml trên VPS!
VITE_COMMON_SERVICE_URL=http://188.166.225.163:8081

# AuthService (hiện tại FE không gọi trực tiếp, đi qua Gateway)
# VITE_AUTH_SERVICE_URL=http://188.166.225.163:8083

# ─── Feature Flags ──────────────────────────────────────────────────────
VITE_FEATURE_FRIEND_SUGGESTIONS=true
