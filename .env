# ─── TTVV Frontend — Environment Variables ──────────────────────────────
# Backend VPS qua Nginx reverse proxy + SSL: 188.166.225.163

# API Gateway (tất cả các REST API + Request đi qua đây)
VITE_API_BASE_URL=https://api.websitedev.software

# SocialService / CommonService (Dành riêng cho WebSocket /ws)
# Đi qua Nginx reverse proxy cùng cổng HTTPS để tránh lỗi bảo mật
VITE_COMMON_SERVICE_URL=https://api.websitedev.software

# ─── Feature Flags ──────────────────────────────────────────────────────
VITE_FEATURE_FRIEND_SUGGESTIONS=true
VITE_FEATURE_BLOCKING=false
VITE_FEATURE_DEVICE_SESSIONS=false
VITE_FEATURE_SCHEDULED_MESSAGES=false
VITE_FEATURE_USER_STATUS=false
VITE_FEATURE_DATA_EXPORT=false
VITE_FEATURE_TWO_FACTOR=false
